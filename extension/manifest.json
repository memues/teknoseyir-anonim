{
  "manifest_version": 3,
  "name": "TeknoSeyir için Anonim Görünüm",
  "version": "1.0.0",
  "description": "TeknoSeyir paylaşımlarında ve yorumlarında yazar adlarını anonim, profil fotoğraflarını siyah gösterir.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TeknoSeyir için Anonim Görünüm",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://teknoseyir.com/*",
        "*://www.teknoseyir.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
